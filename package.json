{
  "name": "style-corner-frontend",
  "version": "1.0.0",
  "description": "Style Corner Mobile-First React/Vite Web Application",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "dev": "vite",
    "server": "node server/server.js",
    "dev:all": "concurrently --kill-others-on-fail -n \"VITE,EXPRESS\" -c \"cyan,yellow\" \"vite\" \"node server/server.js\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "lucide-react": "^0.439.0",
    "mongodb": "^7.2.0",
    "nodemailer": "^8.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1",
    "serve": "^14.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.5",
    "vite": "^5.4.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
